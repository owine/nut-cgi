{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices"
  ],
  "timezone": "America/Chicago",
  "schedule": [
    "on Monday"
  ],
  "automergeSchedule": [
    "at any time"
  ],
  "semanticCommits": "enabled",
  "semanticCommitType": "deps",
  "semanticCommitScope": null,
  "commitBody": "Update {{depName}} from {{currentVersion}} to {{newVersion}}\n\n{{#if releases}}Release notes:\n{{#each releases}}- {{#if title}}{{title}}{{else}}{{version}}{{/if}}\n{{/each}}{{/if}}",
  "ignorePaths": [
    "docker-compose.yml"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track Alpine APK package versions via Repology",
      "managerFilePatterns": [
        "Dockerfile"
      ],
      "matchStringsStrategy": "any",
      "matchStrings": [
        "\\s\\s(?<package>[a-z0-9][a-z0-9-_]+)=(?<currentValue>[a-z0-9-_.]+)\\s+"
      ],
      "versioningTemplate": "loose",
      "datasourceTemplate": "repology",
      "depNameTemplate": "alpine_3_23/{{package}}"
    },
    {
      "customType": "regex",
      "description": "Track NUT (Network UPS Tools) releases from GitHub",
      "managerFilePatterns": [
        "Dockerfile"
      ],
      "matchStrings": [
        "# NUT version to build from source\\s+ARG NUT_VERSION=(?<currentValue>.*?)\\n"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "networkupstools/nut",
      "extractVersionTemplate": "^v(?<version>.*)$"
    }
  ],
  "packageRules": [
    {
      "description": "Alpine base image version updates - manual review (APK pins and Repology depNameTemplate must be updated)",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "alpine"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "automerge": false
    },
    {
      "description": "NUT source version - feat prefix for minor bump, manual review required",
      "matchDatasources": [
        "github-releases"
      ],
      "matchPackageNames": [
        "networkupstools/nut"
      ],
      "semanticCommitType": "feat",
      "automerge": false
    },
    {
      "description": "Group all non-major updates into a single PR",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest",
        "pin"
      ],
      "groupName": "all non-major dependencies",
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "Major updates - separate PRs for review",
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": [
      "security"
    ],
    "assignees": [
      "owine"
    ]
  }
}
