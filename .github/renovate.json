{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices"
  ],
  "timezone": "America/Chicago",
  "schedule": [
    "on Monday"
  ],
  "semanticCommits": "enabled",
  "semanticCommitType": "deps",
  "commitBody": "Update {{depName}} from {{currentVersion}} to {{newVersion}}\n\n{{#if releases}}Release notes:\n{{#each releases}}- {{#if title}}{{title}}{{else}}{{version}}{{/if}}\n{{/each}}{{/if}}",
  "ignorePaths": [
    "docker-compose.yml"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track Alpine APK package versions via Repology",
      "managerFilePatterns": [
        "Dockerfile"
      ],
      "matchStringsStrategy": "any",
      "matchStrings": [
        "\\s\\s(?<package>[a-z0-9][a-z0-9-_]+)=(?<currentValue>[a-z0-9-_.]+)\\s+"
      ],
      "versioningTemplate": "loose",
      "datasourceTemplate": "repology",
      "depNameTemplate": "alpine_3_23/{{package}}"
    },
    {
      "customType": "regex",
      "description": "Track NUT (Network UPS Tools) releases from GitHub",
      "managerFilePatterns": [
        "Dockerfile"
      ],
      "matchStrings": [
        "# NUT version to build from source\\s+ARG NUT_VERSION=(?<currentValue>.*?)\\n"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "networkupstools/nut",
      "extractVersionTemplate": "^v(?<version>.*)$"
    }
  ],
  "packageRules": [
    {
      "description": "Alpine base image digest updates - auto-merge (same version, no APK changes)",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "alpine"
      ],
      "matchUpdateTypes": [
        "digest"
      ],
      "groupName": "alpine base image digest",
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "Alpine base image version updates - manual review (APK pins and Repology depNameTemplate must be updated)",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "alpine"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "alpine base image version",
      "automerge": false
    },
    {
      "description": "Alpine APK packages - auto-merge (patch-level updates within same Alpine release)",
      "matchDatasources": [
        "repology"
      ],
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "NUT source version - manual review required",
      "matchDatasources": [
        "github-releases"
      ],
      "matchPackageNames": [
        "networkupstools/nut"
      ],
      "groupName": "nut source",
      "automerge": false
    },
    {
      "description": "All non-major updates grouped together and auto-merged",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest"
      ],
      "groupName": "non-major dependencies",
      "automerge": true,
      "automergeType": "pr"
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": [
      "security"
    ],
    "assignees": [
      "owine"
    ]
  }
}
